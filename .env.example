# Comma-separated tenant:key pairs (bare keys map to the "default" tenant).
# Required for production unless SCALPEL_OPEN_KEYS=1 (local/dev only).
SCALPEL_API_KEYS=acme:sk_live_change_me

# Tenant -> plan mapping (plans: free = audit-only 10/mo, pro = edits 100/mo,
# enterprise = unlimited). Unmapped tenants get SCALPEL_DEFAULT_PLAN.
SCALPEL_TENANT_PLANS=acme:pro
SCALPEL_DEFAULT_PLAN=enterprise

# Where edited model weights + audit reports are written.
SCALPEL_ARTIFACT_DIR=artifacts

# Durable job store.
SCALPEL_DB_PATH=artifacts/scalpel.db

# torch device for surgeries ("cpu", "cuda", "mps").
SCALPEL_DEVICE=cpu

# Bounded surgery worker pool.
SCALPEL_MAX_CONCURRENT_JOBS=1

# Local/dev only: accept any non-empty API key (isolated per-key tenants).
# Keep OFF in production.
SCALPEL_OPEN_KEYS=0
SCALPEL_REQUIRE_API_KEYS=1

# Optional CORS allow-list (comma-separated origins) if the console is hosted elsewhere.
# SCALPEL_CORS_ORIGINS=https://console.example.com

# Optional HMAC secret for job completion webhooks (X-Scalpel-Signature: sha256=…).
# SCALPEL_WEBHOOK_SECRET=change_me_to_a_long_random_string

# Alert thresholds (|WEAT|).
SCALPEL_ALERT_WEAT_THRESHOLD=0.5
SCALPEL_ALERT_OVERCORRECTION_THRESHOLD=0.3
