# Optional bootstrap tenant:key pairs (bare keys map to the "default" tenant).
# Not required when SCALPEL_PUBLIC_SIGNUP=1 — consumers create workspaces at /signup.
# Keep a bootstrap key for admin/ops if you want a known tenant without signup.
SCALPEL_API_KEYS=acme:sk_live_change_me

# Tenant -> plan mapping (plans: free = audit-only 10/mo, pro = edits 100/mo,
# enterprise = unlimited). Signup accounts start on free. Unmapped env keys get
# SCALPEL_DEFAULT_PLAN (enterprise is convenient for single-tenant self-host).
SCALPEL_TENANT_PLANS=acme:pro
SCALPEL_DEFAULT_PLAN=enterprise

# Where edited model weights + audit reports are written.
SCALPEL_ARTIFACT_DIR=artifacts

# Durable job store (SQLite file for jobs/artifacts metadata).
SCALPEL_DB_PATH=artifacts/scalpel.db

# Postgres for durable signup accounts (required for Netlify / multi-instance).
# Neon, Supabase, Railway, RDS, etc. When unset, users also live in SCALPEL_DB_PATH.
# DATABASE_URL=postgresql://user:pass@host/scalpel
# SCALPEL_DATABASE_URL=postgresql://user:pass@host/scalpel

# Public URL of this API when the marketing site is on another host (optional).
# Leave empty when Netlify proxies /v1/* to this service (recommended).
# SCALPEL_PUBLIC_API_URL=https://api.yourdomain.com

# Netlify build only: API origin written into _redirects proxies.
# SCALPEL_API_ORIGIN=https://api.yourdomain.com

# torch device for surgeries ("cpu", "cuda", "mps").
SCALPEL_DEVICE=cpu

# Bounded surgery worker pool.
SCALPEL_MAX_CONCURRENT_JOBS=1

# Local/dev only: accept any non-empty API key (isolated per-key tenants).
# Keep OFF in production.
SCALPEL_OPEN_KEYS=0
SCALPEL_REQUIRE_API_KEYS=1

# Consumer workspace signup at /signup + POST /v1/auth/signup.
SCALPEL_PUBLIC_SIGNUP=1
# Max signups per client IP per hour (in-memory).
SCALPEL_SIGNUP_RATE_LIMIT=10

# Optional CORS allow-list (comma-separated origins) if the console is hosted elsewhere.
# SCALPEL_CORS_ORIGINS=https://console.example.com

# Optional HMAC secret for job completion webhooks (X-Scalpel-Signature: sha256=…).
# SCALPEL_WEBHOOK_SECRET=change_me_to_a_long_random_string

# Alert thresholds (|WEAT|).
SCALPEL_ALERT_WEAT_THRESHOLD=0.5
SCALPEL_ALERT_OVERCORRECTION_THRESHOLD=0.3
