# Comma-separated tenant:key pairs (bare keys map to the "default" tenant).
SCALPEL_API_KEYS=acme:sk_live_change_me

# Tenant -> plan mapping (plans: free = audit-only 10/mo, pro = edits 100/mo,
# enterprise = unlimited). Unmapped tenants get SCALPEL_DEFAULT_PLAN.
SCALPEL_TENANT_PLANS=acme:pro
SCALPEL_DEFAULT_PLAN=enterprise

# Where edited model weights + audit reports are written.
SCALPEL_ARTIFACT_DIR=artifacts

# Durable job store.
SCALPEL_DB_PATH=artifacts/scalpel.db

# torch device for surgeries ("cpu", "cuda", "mps").
SCALPEL_DEVICE=cpu

# Bounded surgery worker pool.
SCALPEL_MAX_CONCURRENT_JOBS=1
